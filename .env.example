# Example settings. The easy way to create your real settings file is to run
#   keep-to-bring setup
# which asks a few questions, signs you in, and writes the file for you.
#
# Docker reads its settings from ./data/.env; the plain Python install reads ./.env.
# Never commit or share the real file: it contains passwords and login tokens.

# --- Bring! (required) --------------------------------------------------------
BRING_EMAIL=you@example.com
BRING_PASSWORD=your-bring-password
# Which Bring! list voice items go to (default: your default Bring! list)
# BRING_LIST_NAME=Home

# --- Google account(s) used by your Google Home (at least one) ----------------
# Create the master token with:  keep-to-bring get-token
GOOGLE_EMAIL=you@gmail.com
GOOGLE_MASTER_TOKEN=aas_et/...
# A second person with Voice Match (their voice goes to their own Keep list):
# GOOGLE_EMAIL_2=partner@gmail.com
# GOOGLE_MASTER_TOKEN_2=aas_et/...
# (add _3, _4, ... for more)

# --- Optional -----------------------------------------------------------------
# Name(s) of the Google Keep checklist Google Home adds to (comma separated)
# KEEP_LIST_TITLES=Shopping list
# How often to check Google Keep, in seconds (minimum 15)
# POLL_INTERVAL_SECONDS=60
# After copying an item to Bring!: "delete" it from Keep, or "check" it off
# KEEP_ACTION=delete
# "2 gallons of milk" -> item "Milk" with the note "2 gallons"
# PARSE_QUANTITIES=true
# "milk, eggs and bread" said as ONE item -> three items
# SPLIT_ITEMS=false
# Put a reminder on the Bring! list if a Google login stops working
# ALERT_IN_BRING=true
# DEBUG shows much more detail (useful when something isn't working)
# LOG_LEVEL=INFO
